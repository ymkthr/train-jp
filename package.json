{
  "name": "even-g2-norikae",
  "private": true,
  "version": "0.1.14",
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"const fs=require('fs'),k='node_modules/kuromoji/';fs.cpSync(k+'dict','public/kuromoji',{recursive:true});for(const f of ['NOTICE.md','LICENSE-2.0.txt'])fs.copyFileSync(k+f,'public/kuromoji/'+f)\"",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:sherpa": "bash sherpa-wasm/build.sh",
    "build:stations": "node scripts/build-stations.mjs",
    "test": "node --test src/asr/stations.test.mjs src/progress.test.mjs",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist",
    "simulate": "evenhub-simulator http://localhost:5173"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@evenrealities/pretext": "^0.1.4",
    "kuromoji": "^0.1.2"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.7.2",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  },
  "license": "MIT"
}
